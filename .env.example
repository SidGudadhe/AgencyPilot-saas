# Environment Variables — AgencyPilot SaaS
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/agencypilot?schema=public"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI Integration (Google Gemini) ──────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"

# ─── Encryption (for provider tokens at rest) ────────────────────────────────
# Must be exactly 32 characters
ENCRYPTION_KEY="your-32-character-encryption-key!"

# ─── Email (for invitations and password reset) ───────────────────────────────
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="AgencyPilot <noreply@yourdomain.com>"

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AgencyPilot"
