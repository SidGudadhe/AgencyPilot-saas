// This is your Prisma schema file
// Learn more about it at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum AdProvider {
  META
  GOOGLE_ADS
  LINKEDIN
  TWITTER
  SNAPCHAT
  TIKTOK
  JIOADS
  HOTSTAR
  INMOBI
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  DELETED
}

enum AdStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  ARCHIVED
  DELETED
  PENDING_REVIEW
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SyncLogLevel {
  INFO
  WARNING
  ERROR
}

enum RecommendationSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  NEW
  REVIEWING
  APPLIED
  DISMISSED
  RESOLVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DeletionRequestStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  image         String?
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  memberships          WorkspaceMembership[]
  invitationsSent      WorkspaceInvitation[] @relation("InvitedBy")
  aiConversations      AiConversation[]
  deletionRequests     AccountDeletionRequest[]
  auditEvents          AuditEvent[]
  recommendationChanges RecommendationHistory[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner               User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships         WorkspaceMembership[]
  invitations         WorkspaceInvitation[]
  subscriptions       Subscription[]
  integrations        ProviderIntegration[]
  adAccounts          AdAccount[]
  campaigns           Campaign[]
  adGroups            AdGroup[]
  ads                 Ad[]
  adMetrics           AdMetric[]
  syncJobs            SyncJob[]
  analyticsCache      AnalyticsCache[]
  recommendations     Recommendation[]
  aiConversations     AiConversation[]
  auditEvents         AuditEvent[]

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@index([token])
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  billingProvider      String?
  billingProviderId    String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingEvents BillingEvent[]

  @@index([workspaceId])
}

model BillingEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  type           String
  amount         Float?
  currency       String?
  description    String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model ProviderIntegration {
  id                   String            @id @default(cuid())
  workspaceId          String
  provider             AdProvider
  status               IntegrationStatus @default(DISCONNECTED)
  encryptedAccessToken String?
  encryptedRefreshToken String?
  tokenExpiresAt       DateTime?
  metadata             Json?
  lastSyncAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccounts AdAccount[]
  syncJobs   SyncJob[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([status])
}

model AdAccount {
  id             String   @id @default(cuid())
  integrationId  String
  workspaceId    String
  externalId     String
  name           String
  currency       String
  timezone       String?
  status         String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration ProviderIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@unique([integrationId, externalId])
  @@index([workspaceId])
  @@index([integrationId])
}

model Campaign {
  id          String         @id @default(cuid())
  adAccountId String
  workspaceId String
  externalId  String
  name        String
  objective   String?
  status      CampaignStatus @default(ACTIVE)
  budget      Float?
  budgetType  String?
  startDate   DateTime?
  endDate     DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adGroups  AdGroup[]
  ads       Ad[]

  @@unique([adAccountId, externalId])
  @@index([workspaceId])
  @@index([adAccountId])
  @@index([status])
}

model AdGroup {
  id            String   @id @default(cuid())
  campaignId    String
  workspaceId   String
  externalId    String
  name          String
  status        String?
  targetingData Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@unique([campaignId, externalId])
  @@index([workspaceId])
  @@index([campaignId])
}

model Ad {
  id             String   @id @default(cuid())
  adGroupId      String
  campaignId     String
  workspaceId    String
  externalId     String
  name           String
  status         AdStatus @default(ACTIVE)
  provider       AdProvider
  creativeUrl    String?
  thumbnailUrl   String?
  landingPageUrl String?
  adType         String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adGroup         AdGroup           @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metrics         AdMetric[]
  recommendations Recommendation[]

  @@unique([adGroupId, externalId])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([status])
  @@index([provider])
}

model AdMetric {
  id                  String   @id @default(cuid())
  adId                String
  workspaceId         String
  date                DateTime @db.Date
  // Impression & Reach
  impressions         BigInt   @default(0)
  reach               BigInt?
  // Clicks
  clicks              BigInt   @default(0)
  linkClicks          BigInt?
  landingPageViews    BigInt?
  // Video
  videoViews          BigInt?
  videoViews25        BigInt?
  videoViews50        BigInt?
  videoViews75        BigInt?
  videoViews100       BigInt?
  // Spend
  spend               Float    @default(0)
  currency            String   @default("INR")
  // Conversions
  conversions         Float?
  conversionValue     Float?
  conversionCurrency  String?
  // Engagement
  frequency           Float?
  engagements         BigInt?
  shares              BigInt?
  comments            BigInt?
  likes               BigInt?
  saves               BigInt?
  // Calculated metrics (stored for performance)
  ctr                 Float?
  cpc                 Float?
  cpm                 Float?
  costPerConversion   Float?
  roas                Float?
  // Raw provider data
  rawProviderData     Json?
  createdAt           DateTime @default(now())

  ad        Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([workspaceId])
  @@index([adId])
  @@index([date])
  @@index([workspaceId, date])
}

model SyncJob {
  id               String        @id @default(cuid())
  workspaceId      String
  integrationId    String
  status           SyncJobStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  recordsProcessed Int           @default(0)
  createdAt        DateTime      @default(now())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration ProviderIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs        SyncLog[]

  @@index([workspaceId])
  @@index([integrationId])
  @@index([status])
}

model SyncLog {
  id        String       @id @default(cuid())
  syncJobId String
  level     SyncLogLevel @default(INFO)
  message   String
  data      Json?
  createdAt DateTime     @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
}

model AnalyticsCache {
  id          String   @id @default(cuid())
  workspaceId String
  cacheKey    String
  data        Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, cacheKey])
  @@index([workspaceId])
  @@index([expiresAt])
}

model Recommendation {
  id                 String                 @id @default(cuid())
  adId               String
  workspaceId        String
  type               String
  severity           RecommendationSeverity @default(MEDIUM)
  title              String
  description        String
  evidence           Json
  action             String
  reason             String
  expectedImpact     String?
  confidence         String
  assumptions        String?
  risks              String?
  observationPeriod  String?
  status             RecommendationStatus   @default(NEW)
  detectedAt         DateTime               @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  ad        Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  history   RecommendationHistory[]

  @@index([workspaceId])
  @@index([adId])
  @@index([severity])
  @@index([status])
}

model RecommendationHistory {
  id                 String               @id @default(cuid())
  recommendationId   String
  previousStatus     RecommendationStatus?
  newStatus          RecommendationStatus
  changedById        String
  note               String?
  createdAt          DateTime             @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  changedBy      User           @relation(fields: [changedById], references: [id])

  @@index([recommendationId])
}

model AiConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String   @default("New Conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([workspaceId])
  @@index([userId])
}

model AiMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AccountDeletionRequest {
  id                 String                @id @default(cuid())
  userId             String
  status             DeletionRequestStatus @default(PENDING)
  step1ConfirmedAt   DateTime?
  step2ConfirmedAt   DateTime?
  processedAt        DateTime?
  completedAt        DateTime?
  error              String?
  createdAt          DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model AuditEvent {
  id           String   @id @default(cuid())
  userId       String?
  workspaceId  String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([createdAt])
}
